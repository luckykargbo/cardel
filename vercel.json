{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/app-admin-gate(.*)",
      "dest": "/admin.html#/app-admin-gate"
    },
    {
      "src": "/admin-gate(.*)",
      "dest": "/admin.html#/app-admin-gate"
    },
    {
      "src": "/admin-dashboard(.*)",
      "dest": "/admin.html#/admin-dashboard"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
